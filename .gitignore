# ─── Dependencies ─────────────────────────────────────
node_modules/
package-lock.json

# ─── Build outputs ────────────────────────────────────
backend/dist/
web/dist/
web/.angular/

# ─── Environment files ────────────────────────────────
# `.env` alone does not match `.env.production`, which is how the deployment
# environment files ended up committed. Ignore every variant and allow only the
# checked-in template back in.
.env
.env.*
!.env.example

# ─── OS files ─────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ─── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Testing ──────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ─────────────────────────────────────────────
*.tgz
.tmp/
temp/
