# Datastore credentials for the Docker Compose stack.
#
# Copy to `.env` in this directory on the deploy host and fill in real values.
# Compose reads this file for `${...}` interpolation in docker-compose.yml and
# the staging/production overlays. It is NOT the backend's environment — that
# lives in backend/.env.<environment> and is loaded via `env_file`.
#
# Only the staging and production overlays consume these. The base file is the
# local development stack and runs the datastores without authentication, bound
# to 127.0.0.1.
#
# Generate each value with, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# MongoDB root user, created on first boot of an empty data volume and used by
# the backend's MONGODB_URI with authSource=admin.
#
# NOTE: MONGO_INITDB_ROOT_* only takes effect when the data volume is empty.
# Pointing these at a volume that was first initialised without credentials
# leaves that database unauthenticated — the user has to be created by hand with
# db.createUser() before the URI above will work.
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASSWORD=changeme

# Redis, passed to `redis-server --requirepass` and to the backend.
REDIS_PASSWORD=changeme

# Elasticsearch. Sets the password for the built-in `elastic` user and is handed
# to the backend as ELASTICSEARCH_PASSWORD; the overlays enable xpack.security,
# so leaving this blank stops the cluster from starting.
ELASTIC_PASSWORD=changeme
